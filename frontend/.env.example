# DevRamp Frontend Configuration

# FastAPI Backend URL
VITE_API_URL=http://localhost:8000

# Set to 'false' to connect to FastAPI backend, 'true' for local mock UI data
VITE_USE_MOCK_API=false

# GitHub OAuth App client ID (public). Add "repo" to scopes for private repositories.
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_SCOPES=read:user user:email
